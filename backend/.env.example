# AWS / DynamoDB configuration
AWS_REGION=ap-south-1
DYNAMODB_TABLE=raawa-simulations

# Use this when connecting to local DynamoDB (for example, DynamoDB Local or LocalStack)
# DYNAMODB_ENDPOINT=http://localhost:8000

# AWS credentials for cloud DynamoDB
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Backend API key used by the LLM fallback/service layer
OPENAI_API_KEY=your_openai_api_key
